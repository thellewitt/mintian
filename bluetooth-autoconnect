# ---------------------------------------------------------
# Configuration
# ---------------------------------------------------------
DEFAULT_VOLUME = 0.65

RSSI_THRESHOLD = -85
RECOVERY_THRESHOLD = -75

VERBOSE = False
DAEMON = False

AGENT_INTERFACE = "org.bluez.Agent1"
AGENT_PATH = "/test/agent"

# ---------------------------------------------------------
# Runtime Main Loops
